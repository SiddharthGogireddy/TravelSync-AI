# ==============================================================================
# TravelSync AI — Environment Configuration Example (.env.example)
# Copy this file to .env and configure the values for your environment.
# DO NOT COMMIT SENSITIVE SECRETS TO VERSION CONTROL.
# ==============================================================================

# --- AI & External Services ---
# Required for Gemini LLM itinerary planning & prompt updates
GEMINI_API_KEY=your_gemini_api_key_here

# OpenTripMap API key for attraction discovery
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# --- Authentication & JWT Security (Step 75.2) ---
# Secret key used for signing and verifying HMAC SHA-256 JWT access tokens.
# IN PRODUCTION: Must be a random, high-entropy secret of at least 32 bytes (256 bits).
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secure-random-32-byte-secret-key-here

# JWT algorithm: HS256 for symmetric HMAC or RS256 for asymmetric RSA
JWT_ALGORITHM=HS256

# JWT token lifetime in seconds (default: 604800 = 7 days)
JWT_EXPIRATION_SECONDS=604800

# Expected token issuer (iss claim)
OIDC_ISSUER=travelsync-ai

# Expected token audience (aud claim)
OIDC_AUDIENCE=travelsync-api

# --- Enterprise OpenID Connect (OIDC) / OAuth2 Provider Setup ---
# When integrating an external identity provider (e.g., Auth0, Firebase, Keycloak, Okta),
# set OIDC_JWKS_URL to the provider's JSON Web Key Set endpoint.
# Example: https://your-tenant.us.auth0.com/.well-known/jwks.json
# If omitted or empty, local HMAC JWT verification is used.
OIDC_JWKS_URL=

# --- Development Settings ---
# Set to 'true' to enable local dev token auto-provisioning via /auth/token.
# Set to 'false' in production environments with a dedicated identity provider.
AUTH_DEV_MODE=true
