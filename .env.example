# ==============================================================================
# TravelSync AI — Environment Configuration Example (.env.example)
# Copy this file to .env and configure the values for your environment.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL API KEYS TO VERSION CONTROL.
# ==============================================================================

# --- AI & External Services ---
# Required for Gemini LLM itinerary planning & prompt updates
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (defaults to gemini-3.8-flash for current SDK/endpoints)
# Supported options:
#   - gemini-3.8-flash (Recommended production default, high throughput, low latency)
#   - gemini-2.5-flash (Standard flash generation)
#   - gemini-2.0-flash (General purpose multimodal)
#   - gemini-1.5-flash (Legacy fallback)
GEMINI_MODEL=gemini-3.8-flash

# OpenTripMap API key for attraction discovery
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# OpenWeatherMap API key for forecast and severe weather alerts
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Geocoding & Nominatim Policy Compliance ---
# OpenStreetMap Nominatim strictly enforces max 1 request/second and a descriptive User-Agent.
# In single-worker deployment, in-process rate limiting satisfies this automatically.
# In multi-worker or clustered environments: set NOMINATIM_BASE_URL to an internal proxy
# or dedicated self-hosted Nominatim instance.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=TravelSyncAI/1.0 (https://travelsync.ai; contact@travelsync.ai)

# --- Authentication & JWT Security (Step 75.2) ---
# Secret key used for signing and verifying HMAC SHA-256 JWT access tokens.
# IN PRODUCTION: Must be a random, high-entropy secret of at least 32 bytes (256 bits).
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secure-random-32-byte-secret-key-here

# JWT algorithm: HS256 for symmetric HMAC or RS256 for asymmetric RSA
JWT_ALGORITHM=HS256

# JWT token lifetime in seconds (default: 604800 = 7 days)
JWT_EXPIRATION_SECONDS=604800

# Expected token issuer (iss claim)
OIDC_ISSUER=travelsync-ai

# Expected token audience (aud claim)
OIDC_AUDIENCE=travelsync-api

# --- Enterprise OpenID Connect (OIDC) / OAuth2 Provider Setup ---
# When integrating an external identity provider (e.g., Auth0, Firebase, Keycloak, Okta),
# set OIDC_JWKS_URL to the provider's JSON Web Key Set endpoint.
# Example: https://your-tenant.us.auth0.com/.well-known/jwks.json
# If omitted or empty, local HMAC JWT verification is used.
OIDC_JWKS_URL=

# --- Development & Security Mode (Step 84) ---
# Set to 'true' to enable local dev token auto-provisioning via /auth/token and local CORS fallbacks.
# IN PRODUCTION: MUST be set to 'false'.
# When AUTH_DEV_MODE=false:
#   - POST /auth/token is disabled and returns HTTP 403 Forbidden.
#   - JWT_SECRET_KEY is validated at startup and cannot be missing, empty, or the default dev secret.
#   - ALLOWED_ORIGINS is strictly enforced and cannot be missing, empty, or contain '*'.
AUTH_DEV_MODE=true

# --- Cross-Origin Resource Sharing (CORS) (Step 84) ---
# Comma-separated list of permitted origin URLs for CORS requests with credentials.
# In development (AUTH_DEV_MODE=true): Defaults to http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
# IN PRODUCTION (AUTH_DEV_MODE=false): REQUIRED. Wildcards ('*') are strictly prohibited.
# Example: https://travelsync.example.com,https://app.travelsync.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Request Rate Limiting ---
# Configures sliding-window limits per client (verified Bearer token subject, or IP fallback).
# Untrusted X-User-ID headers without valid Bearer tokens are ignored to prevent evasion.
# Single-process deployments use in-process thread-safe sliding windows.
# Multi-worker deployments require an upstream reverse proxy (e.g. NGINX) or Redis backend.
RATELIMIT_AUTH_LIMIT=10
RATELIMIT_AUTH_WINDOW=60
RATELIMIT_AI_LIMIT=10
RATELIMIT_AI_WINDOW=60
RATELIMIT_WEATHER_LIMIT=20
RATELIMIT_WEATHER_WINDOW=60
RATELIMIT_PLACE_LIMIT=30
RATELIMIT_PLACE_WINDOW=60

# --- Reverse Proxy & Forwarded Header Trust ---
# Set to 'true' if application is deployed behind a trusted reverse proxy (NGINX, Cloudflare, ALB)
# that properly strips and appends X-Forwarded-For headers.
# When 'false' (default), X-Forwarded-For is only trusted if the direct connection originates
# from an address listed in TRUSTED_PROXIES (e.g. localhost/loopback). Direct untrusted clients
# cannot bypass rate limits by spoofing X-Forwarded-For.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=127.0.0.1,::1

